# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Data (raw/processed datasets are large and reproducibly downloaded)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# Exception: the deployed dashboard reads this directly (no pipeline step
# runs on Streamlit Community Cloud), so it's committed despite the rule above.
!data/processed/household_energy_hourly.csv

# Model artifacts
*.h5
*.pkl
*.joblib
models/checkpoints/

# Reports output (keep source, ignore generated binaries)
reports/*.pdf
reports/*.docx

# Environment / secrets
.env

# OS / editor
.DS_Store
.vscode/
.idea/

# Unrelated stray file that occasionally lands in this directory (not project output)
/offline.zip

# Testing / tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
